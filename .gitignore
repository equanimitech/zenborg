# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/plugin/__pycache__
# written by Claude Code when it loads the plugin as a mod
/plugin/tsconfig.json
/plugin/.claude-plugin/types/

# Rust build artifacts (crates have their own targets when built standalone)
src-tauri/crates/*/target/
src-tauri/crates/*/Cargo.lock
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# typescript
*.tsbuildinfo
next-env.d.ts

.claude/worktrees/**
.claude/settings.local.json
**/.claude/settings.local.json
.worktrees/

feature-lab

# playwright mcp session dumps
.playwright-mcp/

# scraped/local data dumps
/data/

# compiled sidecars (built by src-tauri/scripts/build-sidecars.sh)
/src-tauri/binaries/
/calendar-sidecar/dist/

# bun lockfile (we use pnpm; bun is build-time-only via `bun build --compile`)
mcp-server/bun.lock


# Garmin backing: local payloads, real habit map (contains vault UUIDs)
.local/
*.local.json
.claude/*.local.md
.claude/attently/
*.local.csv
highlights.local.json

# playwright test runs
/test-results/
/playwright-report/
/blob-report/
/e2e/**/*-snapshots/
